/* Write your T-SQL query statement below */
with tmp as ( 
    select 
project_id
,p.employee_id
,dense_rank() over (partition by project_id order by experience_years desc) as exp
from project p 
left join employee e on p.employee_id = e.employee_id)

select 
project_id
,employee_id
from tmp
where exp = 1

-- group by project_id