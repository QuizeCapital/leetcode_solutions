import pandas as pd

def count_comments(submissions: pd.DataFrame) -> pd.DataFrame:
    submissions = submissions.merge(submissions, how = 'left' ,left_on = 'sub_id',
    right_on = 'parent_id')

    submissions =  submissions[submissions['parent_id_x'].isna()]
    # submissions['na_flag'] = np.where(submissions['sub_id_y'].isna(), 0,  submissions['sub_id_y'])

    agg_dict = {
        'number_of_comments' : ('sub_id_y' , 'nunique')
    }

    for new_col, (col, func) in agg_dict.items():
        submissions[new_col] = submissions.groupby(['sub_id_x'])[col].transform(func)
    
    submissions = submissions.rename(columns = {'sub_id_x' : 'post_id' })
    return submissions.drop_duplicates(['post_id', 'number_of_comments'])[['post_id', 'number_of_comments']].sort_values(['post_id'])
    