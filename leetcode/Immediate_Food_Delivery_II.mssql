/* Write your T-SQL query statement below */
with tmp as (select 
*
,case when (min(order_date) over (partition by customer_id) = customer_pref_delivery_date) then 1 else 0 end as flag
from delivery)

select 
round(sum(flag) * 1.0/ count(distinct customer_id) * 100, 2) as immediate_percentage
from tmp