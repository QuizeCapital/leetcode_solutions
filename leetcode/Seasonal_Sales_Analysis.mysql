# Write your MySQL query statement below
with tmp as (select 
s.product_id
,category
, case when monthname(sale_date) = 'December' or monthname(sale_date) = 'January' or monthname(sale_date) = 'February' then 'Winter'  
       when monthname(sale_date) = 'March' or monthname(sale_date) = 'April' or monthname(sale_date) = 'May' then 'Spring'
       when monthname(sale_date) = 'June' or monthname(sale_date) = 'July' or monthname(sale_date) = 'August' then 'Summer'
       when monthname(sale_date) = 'September' or monthname(sale_date) = 'October' or monthname(sale_date) = 'November' then 'Fall'
end as season
, sum(quantity) as total_quantity
, sum(quantity * price) as total_revenue

from sales s
left join products p on s.product_id = p.product_id
group by season, category
order by season asc),

ranked as (select 
season
,category
,total_quantity
,total_revenue
,dense_rank() over (partition by season order by total_quantity desc, total_revenue desc) as pos
from tmp)

select
season
,category
,total_quantity
,total_revenue
from ranked 
where pos = 1 
