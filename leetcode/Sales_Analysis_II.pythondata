import pandas as pd

def sales_analysis(product: pd.DataFrame, sales: pd.DataFrame) -> pd.DataFrame:
    df = sales.merge(product, on = 'product_id', how = 'left')

    df['iphones'] = np.where(df['product_name'] == 'iPhone', 1, 0)
    df['s8'] = np.where(df['product_name'] == 'S8', 1, 0)

    agg_dict ={
        'sum_iphones' : ('iphones', 'sum')
        ,'sum_s8' : ('s8', 'sum')
    }

    for new_col, (col, func) in agg_dict.items():
        df[new_col] = df.groupby('buyer_id')[col].transform(func)

    return df.drop_duplicates('buyer_id')[(df['sum_iphones'] == 0) & (df['sum_s8'] > 0)][['buyer_id']]
    