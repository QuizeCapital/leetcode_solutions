class Solution(object):
    def sumOddLengthSubarrays(self, arr):
        """
        :type arr: List[int]
        :rtype: int
        """
        sum_final = 0
        for i in range(len(arr)):
            for j in range(i, len(arr), 2):
                sum_final += sum(i for i in arr[i: j + 1])
        return sum_final