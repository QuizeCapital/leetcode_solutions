/* Write your T-SQL query statement below */
with max_sal as (
select 
company_id
,case when max(salary) < 1000 then 0 
      when max(salary) >= 1000 and max(salary)<= 10000 then 0.24
      else 0.49 end as perc
from Salaries
group by company_id)

select
s.company_id
,s.employee_id
,s.employee_name
-- ,s.salary
-- , perc
, round(s.salary - (perc * s.salary), 0) as salary
from Salaries s
left join max_sal m on s.company_id = m.company_id