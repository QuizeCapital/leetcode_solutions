class Solution(object):
    def numberCount(self, a, b):
        """
        :type a: int
        :type b: int
        :rtype: int
        """
        def unique_(a):
            fin_lis = []
            dict_un = defaultdict(int)
            for i in list(str(a)):
                dict_un[i] += 1
            for key, val in dict_un.items():
                if val == 1:
                   fin_lis.append(key)
            return fin_lis
        # print(unique_(19))
        count_unique = 0 
        for i in range(a, b+1):
            # if len(list(str(i))) == len(set(list(str(i)))):
            if len(list(str(i))) == len(unique_(i)):
                count_unique += 1
        return count_unique