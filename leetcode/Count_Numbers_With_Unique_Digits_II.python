class Solution(object):
    def numberCount(self, a, b):
        """
        :type a: int
        :type b: int
        :rtype: int
        """
        count_unique = 0
        for i in range(a, b+1):
            if len(list(str(i))) == len(set(list(str(i)))):
                count_unique += 1
        return count_unique