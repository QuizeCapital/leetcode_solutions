# Write your MySQL query statement below
with tmp as (
    select 
    user1_id
    from friendship
    where user2_id = 1
    union 
    select 
    user2_id
    from friendship
    where user1_id = 1

),

user1_selections as (
select 
page_id 
from likes
where user_id = 1
)

-- select * from user1_selections
select 
distinct page_id as recommended_page
from friendship f
right join likes l on f.user1_id = l.user_id 
where user_id > 1
and page_id not in (select * from user1_selections)
and user_id in (select * from tmp)
order by 1 desc
