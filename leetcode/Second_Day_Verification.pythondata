import pandas as pd

def find_second_day_signups(emails: pd.DataFrame, texts: pd.DataFrame) -> pd.DataFrame:

    texts = texts[texts['signup_action'] == 'Verified']
    df = emails.merge(texts, on = 'email_id')
    df['signup_date'] = pd.to_datetime(df['signup_date']).dt.strftime("%Y%m%d")
    df['action_date'] = pd.to_datetime(df['action_date']).dt.strftime("%Y%m%d")
    date_flag = (df['action_date'].astype(int) - df['signup_date'].astype(int) == 1) & (df['signup_date'] < df['action_date']) 
    # & (df['action_date'] - df['signup_date'] == 1)

    return df[date_flag][['user_id']].sort_values(['user_id'])
    